
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#172554"
                android:paddingBottom="20dp" />

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:text="🎓"
                    android:textSize="42sp" />

                <TextView
                    android:id="@+id/profileHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Raviraj Kadam"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#172554" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="CampusFind Student"
                    android:textSize="14sp"
                    android:textColor="#64748B" />

            </LinearLayout>

            <!-- Personal Information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Personal Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#172554" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FFFFFF">

                <!-- Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="13sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:text="Raviraj Kadam"
                    android:textSize="15sp"
                    android:textColor="#172554" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD" />

                <!-- College -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="College"
                    android:textSize="13sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/profileCollege"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:text="DYPSEM College, Kolhapur"
                    android:textSize="15sp"
                    android:textColor="#172554" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD" />

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Email Address"
                    android:textSize="13sp"
                    android:textColor="#64748B" />

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:text="kadamraviraj3010@gmail.com"
                    android:textSize="15sp"
                    android:textColor="#172554" />

            </LinearLayout>

            <!-- Account Options -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Account"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#172554" />

            <!-- Settings -->
            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="⚙  Settings                              ›"
                android:textSize="15sp"
                android:textColor="#172554"
                android:clickable="true"
                android:focusable="true" />

            <!-- Help and Support -->
            <TextView
                android:id="@+id/helpButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="❓  Help &amp; Support                ›"
                android:textSize="15sp"
                android:textColor="#172554"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

    <!-- Common Bottom Navigation -->
    <include layout="@layout/layout_bottom_navigation" />

</LinearLayout>
